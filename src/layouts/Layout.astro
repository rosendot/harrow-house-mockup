---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/harrow.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "The Harrow House — a fourteen-room boutique inn in a restored 1890s captain's house on Camden Harbor, Maine. Breakfast included, harbor four minutes' walk.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<script>
  // Ported from the design's shared harrow.js. Every block guards on its own
  // selector, so it no-ops on pages that don't have that markup.

  /* --- Header shadow after scroll --- */
  const header = document.getElementById("header");
  if (header) {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  /* --- Mobile drawer --- */
  const navToggle = document.getElementById("navToggle");
  const drawer = document.getElementById("drawer");
  const scrim = document.getElementById("drawerScrim");
  const drawerClose = document.getElementById("drawerClose");

  const openDrawer = () => {
    drawer?.classList.add("open");
    scrim?.classList.add("open");
    navToggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };
  const closeDrawer = () => {
    drawer?.classList.remove("open");
    scrim?.classList.remove("open");
    navToggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  navToggle?.addEventListener("click", openDrawer);
  scrim?.addEventListener("click", closeDrawer);
  drawerClose?.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer?.classList.contains("open")) closeDrawer();
  });

  document.querySelectorAll<HTMLElement>(".drawer-toggle").forEach((t) => {
    t.addEventListener("click", () => {
      const open = t.classList.toggle("open");
      t.setAttribute("aria-expanded", open ? "true" : "false");
      const sub = t.nextElementSibling;
      if (sub?.classList.contains("drawer-sub")) sub.classList.toggle("open");
    });
  });

  /* --- Hero slideshow (auto crossfade, 5s) --- */
  const slideshow = document.querySelector("[data-slideshow]");
  if (slideshow) {
    const slides = Array.from(slideshow.querySelectorAll<HTMLElement>(".hs-slide"));
    const dots = Array.from(slideshow.querySelectorAll<HTMLElement>(".hs-dot"));
    let idx = 0;
    let timer: ReturnType<typeof setInterval>;

    const show = (n: number) => {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("active", i === idx));
      dots.forEach((d, i) => d.classList.toggle("active", i === idx));
    };
    const start = () => {
      timer = setInterval(() => show(idx + 1), 5000);
    };
    const reset = () => {
      clearInterval(timer);
      start();
    };

    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        show(i);
        reset();
      }),
    );
    show(0);
    // Auto-advance is decorative — hold on the first slide for anyone who
    // asked for reduced motion.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) start();
  }

  /* --- Testimonial slider (auto, 6s + dots) --- */
  const tslider = document.querySelector("[data-testimonial]");
  if (tslider) {
    const tslides = Array.from(tslider.querySelectorAll<HTMLElement>(".ts-slide"));
    const tdots = Array.from(tslider.querySelectorAll<HTMLElement>(".ts-dot"));
    let ti = 0;
    let ttimer: ReturnType<typeof setInterval>;

    const tshow = (n: number) => {
      ti = (n + tslides.length) % tslides.length;
      tslides.forEach((s, i) => s.classList.toggle("active", i === ti));
      tdots.forEach((d, i) => d.classList.toggle("active", i === ti));
    };
    const tstart = () => {
      ttimer = setInterval(() => tshow(ti + 1), 6000);
    };
    const treset = () => {
      clearInterval(ttimer);
      tstart();
    };

    tdots.forEach((d, i) =>
      d.addEventListener("click", () => {
        tshow(i);
        treset();
      }),
    );
    tshow(0);
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) tstart();
  }

  /* --- Menu grid category filter tabs --- */
  const mg = document.querySelector("[data-menu-grid]");
  if (mg) {
    const tabs = Array.from(mg.querySelectorAll<HTMLElement>(".mg-tab"));
    const cards = Array.from(mg.querySelectorAll<HTMLElement>(".mg-card"));
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.toggle("active", t === tab));
        const cat = tab.getAttribute("data-cat");
        cards.forEach((c) => {
          const show = cat === "all" || c.getAttribute("data-cat") === cat;
          c.classList.toggle("hide", !show);
        });
      });
    });
  }

  /* --- FAQ accordion --- */
  document.querySelectorAll<HTMLElement>("[data-faq] .faq-item").forEach((item) => {
    const q = item.querySelector<HTMLElement>(".faq-q");
    const a = item.querySelector<HTMLElement>(".faq-a");
    if (!q || !a) return;
    // Any item marked open in the markup needs its height set on load.
    if (item.classList.contains("open")) a.style.maxHeight = `${a.scrollHeight}px`;
    q.setAttribute("aria-expanded", item.classList.contains("open") ? "true" : "false");
    q.addEventListener("click", () => {
      const isOpen = item.classList.contains("open");
      item.classList.toggle("open", !isOpen);
      q.setAttribute("aria-expanded", isOpen ? "false" : "true");
      a.style.maxHeight = isOpen ? "" : `${a.scrollHeight}px`;
    });
  });

  /* --- Lightbox gallery --- */
  const lb = document.getElementById("lightbox");
  const galItems = Array.from(document.querySelectorAll<HTMLElement>("[data-gal-item]"));
  if (lb && galItems.length) {
    const lbImg = lb.querySelector<HTMLImageElement>("[data-lb-img]");
    const lbCap = lb.querySelector<HTMLElement>("[data-lb-cap]");
    let current = 0;

    const open = (i: number) => {
      current = (i + galItems.length) % galItems.length;
      const item = galItems[current];
      // Each thumbnail carries its own src/alt, so the viewer shows the full
      // photo for whichever tile was tapped.
      if (lbImg) {
        lbImg.src = item.getAttribute("data-gal-src") ?? "";
        lbImg.alt = item.getAttribute("data-gal-alt") ?? "";
      }
      if (lbCap) lbCap.textContent = item.getAttribute("data-gal-cap") ?? "";
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      lb.classList.remove("open");
      document.body.style.overflow = "";
    };

    galItems.forEach((item, i) => item.addEventListener("click", () => open(i)));
    lb.querySelector(".lb-prev")?.addEventListener("click", (e) => {
      e.stopPropagation();
      open(current - 1);
    });
    lb.querySelector(".lb-next")?.addEventListener("click", (e) => {
      e.stopPropagation();
      open(current + 1);
    });
    lb.querySelector(".lb-close")?.addEventListener("click", close);
    lb.addEventListener("click", (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener("keydown", (e) => {
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") open(current - 1);
      else if (e.key === "ArrowRight") open(current + 1);
    });
  }

  /* --- Live front-desk hours status: 7am–9pm daily --- */
  const hoursCard = document.querySelector("[data-hours]");
  if (hoursCard) {
    const OPEN_HOUR = 7;
    const CLOSE_HOUR = 21;
    const now = new Date();
    const hour = now.getHours() + now.getMinutes() / 60;
    const isOpen = hour >= OPEN_HOUR && hour < CLOSE_HOUR;

    const label = hoursCard.querySelector("[data-hours-label]");
    const sub = hoursCard.querySelector("[data-hours-sub]");

    // The pill carries the state as text + fill; there's no status dot.
    if (label) {
      label.textContent = isOpen ? "Open now" : "Closed";
      label.classList.toggle("closed", !isOpen);
    }
    if (sub) {
      sub.textContent = isOpen
        ? "Today until 9:00pm"
        : hour < OPEN_HOUR
          ? "Opens today at 7:00am"
          : "Opens tomorrow at 7:00am";
    }
  }

  /* --- Prevent dead-link jumps on visual-only forms --- */
  document.querySelectorAll<HTMLFormElement>("form[data-visual]").forEach((f) => {
    f.addEventListener("submit", (e) => e.preventDefault());
  });
</script>
