---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/harrow.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "The Harrow House — a fourteen-room boutique inn in a restored 1890s captain's house on Camden Harbor, Maine. Breakfast included, harbor four minutes' walk.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    <!-- Wordmark brand: no header/footer icon by design. These are just the
         browser-tab + share-card assets, from an "HH" monogram + the wordmark.
         Generated by .brand/build-assets.mjs. -->
    <link rel="icon" type="image/webp" sizes="32x32" href="/favicon-32.webp" />
    <link rel="icon" type="image/webp" sizes="192x192" href="/icon-192.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<script>
  // Ported from the design's shared harrow.js. Every block guards on its own
  // selector, so it no-ops on pages that don't have that markup.

  /* --- Header shadow after scroll --- */
  const header = document.getElementById("header");
  if (header) {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  /* --- Mobile drawer --- */
  const navToggle = document.getElementById("navToggle");
  const drawer = document.getElementById("drawer");
  const scrim = document.getElementById("drawerScrim");
  const drawerClose = document.getElementById("drawerClose");

  // Scroll lock. `overflow: hidden` on <body> is not enough: the scroll lives
  // on the document, so hiding the overflow reflows the page and *drops* the
  // offset — opening the drawer partway down the page and closing it landed
  // the reader somewhere else. Pinning the body holds the position exactly,
  // and it is also the only variant iOS Safari honours.
  let lockedY = 0;
  const lockScroll = () => {
    document.body.style.position = "fixed";
    document.body.style.top = `-${lockedY}px`;
    document.body.style.left = "0";
    document.body.style.right = "0";
    document.body.style.overflow = "hidden";
  };
  const unlockScroll = () => {
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.left = "";
    document.body.style.right = "";
    document.body.style.overflow = "";
    // behavior: "instant" is required. `html { scroll-behavior: smooth }`
    // otherwise turns this restore into an animated scroll from 0 — the
    // reader watches the whole page fly past on the way back to where they
    // already were, and anything reading the position mid-flight sees a
    // number that is simply wrong. Smooth is for anchor jumps, not for
    // putting someone back where they started.
    window.scrollTo({ top: lockedY, left: 0, behavior: "instant" });
  };

  const drawerFocusables = () =>
    Array.from(
      drawer?.querySelectorAll<HTMLElement>("a[href], button:not([disabled])") ?? [],
    ).filter((el) => el.offsetParent !== null);

  const isDrawerOpen = () => drawer?.classList.contains("open") ?? false;

  const openDrawer = () => {
    // Read the scroll offset before any DOM mutation — adding .open reflows
    // the page and can reset scrollY before we have recorded it.
    lockedY = window.scrollY;
    drawer?.classList.add("open");
    scrim?.classList.add("open");
    navToggle?.setAttribute("aria-expanded", "true");
    navToggle?.setAttribute("aria-label", "Close menu");
    lockScroll();
    // preventScroll: focusing inside the fixed panel otherwise nudges the
    // pinned body and the restore lands a few pixels off.
    drawerClose?.focus({ preventScroll: true });
    document.addEventListener("keydown", onDrawerKeydown);
  };
  const closeDrawer = (restoreFocus = true) => {
    drawer?.classList.remove("open");
    scrim?.classList.remove("open");
    navToggle?.setAttribute("aria-expanded", "false");
    navToggle?.setAttribute("aria-label", "Open menu");
    unlockScroll();
    document.removeEventListener("keydown", onDrawerKeydown);
    if (restoreFocus) navToggle?.focus({ preventScroll: true });
  };

  function onDrawerKeydown(e: KeyboardEvent) {
    if (e.key === "Escape") {
      e.preventDefault();
      closeDrawer();
      return;
    }
    // Trap Tab inside the drawer. Untrapped, the first Tab leaves the panel
    // and lands on the hero buttons underneath it — a keyboard user driving
    // content they cannot see.
    if (e.key === "Tab") {
      const items = drawerFocusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  navToggle?.addEventListener("click", () =>
    isDrawerOpen() ? closeDrawer() : openDrawer(),
  );
  scrim?.addEventListener("click", () => closeDrawer());
  drawerClose?.addEventListener("click", () => closeDrawer());
  // Close on link tap. Every link is a real navigation, so don't steal focus
  // back to the burger on the way out.
  drawer?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a[href]")) closeDrawer(false);
  });
  // Reset if the viewport grows past the drawer breakpoint while it's open,
  // or the body stays locked with no visible menu to unlock it.
  window.matchMedia("(min-width: 861px)").addEventListener("change", (e) => {
    if (e.matches && isDrawerOpen()) closeDrawer(false);
  });

  document.querySelectorAll<HTMLElement>(".drawer-toggle").forEach((t) => {
    t.addEventListener("click", () => {
      const open = t.classList.toggle("open");
      t.setAttribute("aria-expanded", open ? "true" : "false");
      const sub = t.nextElementSibling;
      if (sub?.classList.contains("drawer-sub")) sub.classList.toggle("open");
    });
  });

  /* --- Hero slideshow (auto crossfade, 5s) --- */
  const slideshow = document.querySelector("[data-slideshow]");
  if (slideshow) {
    const slides = Array.from(slideshow.querySelectorAll<HTMLElement>(".hs-slide"));
    const dots = Array.from(slideshow.querySelectorAll<HTMLElement>(".hs-dot"));
    let idx = 0;
    let timer: ReturnType<typeof setInterval>;

    const show = (n: number) => {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("active", i === idx));
      dots.forEach((d, i) => d.classList.toggle("active", i === idx));
    };
    const start = () => {
      timer = setInterval(() => show(idx + 1), 5000);
    };
    const reset = () => {
      clearInterval(timer);
      start();
    };

    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        show(i);
        reset();
      }),
    );
    show(0);
    // Auto-advance is decorative — hold on the first slide for anyone who
    // asked for reduced motion.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) start();
  }

  /* --- Testimonial slider (auto, 6s + dots) --- */
  const tslider = document.querySelector("[data-testimonial]");
  if (tslider) {
    const tslides = Array.from(tslider.querySelectorAll<HTMLElement>(".ts-slide"));
    const tdots = Array.from(tslider.querySelectorAll<HTMLElement>(".ts-dot"));
    let ti = 0;
    let ttimer: ReturnType<typeof setInterval>;

    const tshow = (n: number) => {
      ti = (n + tslides.length) % tslides.length;
      tslides.forEach((s, i) => s.classList.toggle("active", i === ti));
      tdots.forEach((d, i) => d.classList.toggle("active", i === ti));
    };
    const tstart = () => {
      ttimer = setInterval(() => tshow(ti + 1), 6000);
    };
    const treset = () => {
      clearInterval(ttimer);
      tstart();
    };

    tdots.forEach((d, i) =>
      d.addEventListener("click", () => {
        tshow(i);
        treset();
      }),
    );
    tshow(0);
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) tstart();
  }

  /* --- Menu grid category filter tabs --- */
  const mg = document.querySelector("[data-menu-grid]");
  if (mg) {
    const tabs = Array.from(mg.querySelectorAll<HTMLElement>(".mg-tab"));
    const cards = Array.from(mg.querySelectorAll<HTMLElement>(".mg-card"));
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.toggle("active", t === tab));
        const cat = tab.getAttribute("data-cat");
        cards.forEach((c) => {
          const show = cat === "all" || c.getAttribute("data-cat") === cat;
          c.classList.toggle("hide", !show);
        });
      });
    });
  }

  /* --- FAQ accordion --- */
  document.querySelectorAll<HTMLElement>("[data-faq] .faq-item").forEach((item) => {
    const q = item.querySelector<HTMLElement>(".faq-q");
    const a = item.querySelector<HTMLElement>(".faq-a");
    if (!q || !a) return;
    // Any item marked open in the markup needs its height set on load.
    if (item.classList.contains("open")) a.style.maxHeight = `${a.scrollHeight}px`;
    q.setAttribute("aria-expanded", item.classList.contains("open") ? "true" : "false");
    q.addEventListener("click", () => {
      const isOpen = item.classList.contains("open");
      item.classList.toggle("open", !isOpen);
      q.setAttribute("aria-expanded", isOpen ? "false" : "true");
      a.style.maxHeight = isOpen ? "" : `${a.scrollHeight}px`;
    });
  });

  /* --- Lightbox gallery --- */
  const lb = document.getElementById("lightbox");
  const galItems = Array.from(document.querySelectorAll<HTMLElement>("[data-gal-item]"));
  if (lb && galItems.length) {
    const lbImg = lb.querySelector<HTMLImageElement>("[data-lb-img]");
    const lbCap = lb.querySelector<HTMLElement>("[data-lb-cap]");
    let current = 0;

    const open = (i: number) => {
      current = (i + galItems.length) % galItems.length;
      const item = galItems[current];
      // Each thumbnail carries its own src/alt, so the viewer shows the full
      // photo for whichever tile was tapped.
      if (lbImg) {
        lbImg.src = item.getAttribute("data-gal-src") ?? "";
        lbImg.alt = item.getAttribute("data-gal-alt") ?? "";
      }
      if (lbCap) lbCap.textContent = item.getAttribute("data-gal-cap") ?? "";
      // Same pinned lock as the drawer — plain `overflow: hidden` drops the
      // scroll offset, so closing the lightbox returned the reader to a
      // different part of the gallery than the tile they opened.
      if (!lb.classList.contains("open")) {
        lockedY = window.scrollY;
        lb.classList.add("open");
        lockScroll();
      }
    };
    const close = () => {
      lb.classList.remove("open");
      unlockScroll();
    };

    galItems.forEach((item, i) => item.addEventListener("click", () => open(i)));
    lb.querySelector(".lb-prev")?.addEventListener("click", (e) => {
      e.stopPropagation();
      open(current - 1);
    });
    lb.querySelector(".lb-next")?.addEventListener("click", (e) => {
      e.stopPropagation();
      open(current + 1);
    });
    lb.querySelector(".lb-close")?.addEventListener("click", close);
    lb.addEventListener("click", (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener("keydown", (e) => {
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") open(current - 1);
      else if (e.key === "ArrowRight") open(current + 1);
    });
  }

  /* --- Live front-desk hours status: 7am–9pm daily --- */
  const hoursCard = document.querySelector("[data-hours]");
  if (hoursCard) {
    const OPEN_HOUR = 7;
    const CLOSE_HOUR = 21;
    const now = new Date();
    const hour = now.getHours() + now.getMinutes() / 60;
    const isOpen = hour >= OPEN_HOUR && hour < CLOSE_HOUR;

    const label = hoursCard.querySelector("[data-hours-label]");
    const sub = hoursCard.querySelector("[data-hours-sub]");

    // The pill carries the state as text + fill; there's no status dot.
    if (label) {
      label.textContent = isOpen ? "Open now" : "Closed";
      label.classList.toggle("closed", !isOpen);
    }
    if (sub) {
      sub.textContent = isOpen
        ? "Today until 9:00pm"
        : hour < OPEN_HOUR
          ? "Opens today at 7:00am"
          : "Opens tomorrow at 7:00am";
    }
  }

  /* --- Prevent dead-link jumps on visual-only forms --- */
  document.querySelectorAll<HTMLFormElement>("form[data-visual]").forEach((f) => {
    f.addEventListener("submit", (e) => e.preventDefault());
  });
</script>
